# Ollama Cloud
# Create an API key in your Ollama account.
OLLAMA_API_KEY=replace_me

# Direct Ollama Cloud host.
OLLAMA_HOST=https://ollama.com

# Direct Cloud API model name.
OLLAMA_MODEL=gpt-oss:120b

# SafiPay internal service URLs
WALLET_SERVICE_URL=http://wallet-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
STOKVEL_SERVICE_URL=http://stokvel-service:8084
MERCHANT_SERVICE_URL=http://merchant-service:8086
